{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\.]+\\.[^\\.]+\\.[^\\.]+$"
    }
  }
}
