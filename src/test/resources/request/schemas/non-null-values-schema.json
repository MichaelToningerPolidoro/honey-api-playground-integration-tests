{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "General Schema to validade non null fields",
  "type": "object",
  "additionalProperties": { "$ref": "#/definitions/node" },
  "definitions": {
    "node": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/node" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}