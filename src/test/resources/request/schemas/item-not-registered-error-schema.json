{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item not registered error response",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "resource"],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "endpoint"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/v1/.+"
        }
      }
    }
  }
}
